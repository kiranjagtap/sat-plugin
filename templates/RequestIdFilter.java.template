package __TARGET_PACKAGE__;

import jakarta.servlet.FilterChain;
import jakarta.servlet.ServletException;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import java.io.IOException;
import java.util.UUID;
import org.slf4j.MDC;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;
import org.springframework.web.filter.OncePerRequestFilter;

/**
 * Tags every request with a correlation id so log lines from a single HTTP call can be
 * grouped together, even when requests overlap. The id is read from the incoming header
 * (default {@code X-Request-Id}) when a caller (e.g. a test harness) supplies one, otherwise
 * a fresh one is generated; either way it is echoed back in the response header and placed
 * in SLF4J's MDC under the configured key (default {@code requestId}).
 *
 * <p>The header name and MDC key are overridable via {@code sat.correlation.header} /
 * {@code sat.correlation.mdc-key} — useful if this project's existing logging setup (or an
 * org-wide Splunk field extraction) already expects a different name. Whichever key is in
 * use, it only shows up in actual log output if this project's logging configuration —
 * whether that's Spring Boot's {@code logging.pattern.*} properties or a hand-written
 * {@code logback.xml}/{@code logback-spring.xml} — renders {@code %X{<mdc-key>}} somewhere.
 * {@code /sat-scaffold} checks this and tells you plainly if it couldn't confirm it.
 */
@Component
public class RequestIdFilter extends OncePerRequestFilter {

    @Value("${sat.correlation.header:X-Request-Id}")
    private String requestIdHeader;

    @Value("${sat.correlation.mdc-key:requestId}")
    private String mdcKey;

    @Override
    protected void doFilterInternal(
            HttpServletRequest request, HttpServletResponse response, FilterChain filterChain)
            throws ServletException, IOException {
        String requestId = request.getHeader(requestIdHeader);
        if (requestId == null || requestId.isBlank()) {
            requestId = UUID.randomUUID().toString();
        }
        response.setHeader(requestIdHeader, requestId);
        MDC.put(mdcKey, requestId);
        try {
            filterChain.doFilter(request, response);
        } finally {
            MDC.remove(mdcKey);
        }
    }
}
